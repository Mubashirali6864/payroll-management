# Production Environment Variables for Hostinger
# Copy this to .env and fill in your values

# Server
NODE_ENV=production
PORT=3000

# Database (SQLite file path - will be created automatically)
DB_PATH=./data/payroll.sqlite

# Company Settings (optional - can be configured via UI)
COMPANY_NAME=Mohsin & Co
COMPANY_CONTACT=+92 300 0000000
COMPANY_ADDRESS=Karachi, Pakistan

# File Uploads
UPLOAD_DIR=./data/documents
MAX_FILE_SIZE=10485760

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secure-random-string-min-32-chars
SESSION_SECRET=another-super-secure-random-string-min-32-chars

# CORS (set to your production domain)
CORS_ORIGIN=https://ghostwhite-camel-781949.hostingersite.com

# Rate Limiting & Proxy Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Set TRUST_PROXY=1 when deploying behind a reverse proxy (e.g. Hostinger, Nginx, Cloudflare)
TRUST_PROXY=1

# Logging
LOG_LEVEL=info